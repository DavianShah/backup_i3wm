/* launcher.rasi - rofi drun launcher ($mod+d), i3 session only.
 *
 * Reference look: 1000px centered glass panel, 1px white border, wallpaper
 * strip header, white-glass pill search + mode buttons, 2x8 list.
 * Neutral palette only: white/gray + alpha over picom blur (no warm hues).
 *
 * Geometry (auto dpi ~96: 10pt -> 17px line, 9pt -> 16px line; measured
 * under Xvfb, confirmed by scripts/make-header.sh):
 *   entry      = 17 line + 2x10 padding              = 37px
 *   inputbar   = entry + 2x1 border                  = 39px
 *   button     = 16 line + 2x5 padding + 2x1 border  = 28px
 *   mode-switcher = button + 2x6 padding + 2x1       = 42px
 *   header     = 42 + 2x76 padding + 2x1 border      = 196px -> 972x196 box
 *                image = scripts/make-header.sh (scale "none", r=18 corners
 *                baked, wallpaper crop at screen 474,306 + HEADER_DX/DY)
 *   element    = 22 icon + 2x10 padding              = 42px, +6 spacing = 48 pitch
 *   listview   = 2 border + 8x42 + 7x6               = 380px
 *   window h   ~= 2 + 24 + 196 + 12 + 380 + 2        = 616px
 *
 * Every widget and state carries an explicit color so rofi's built-in light
 * defaults (white entry/prompt/message boxes) can never surface.
 */

* {
    win-bg:   #1A1A1A94;   /* neutral dark gray 58% - picom blur shows through */
    win-fall: #1A1A1A94;   /* fallback under the header strip corners        */
    edge:     #FFFFFF21;   /* window / button border, white 13%              */
    peach:    #FFFFFF2E;   /* selected-row glass, white 18% (name kept)      */
    fg:       #E6E6E6;     /* list + message text                            */
    fg-dim:   #9A9A9A;     /* prompt, case indicator                         */
    ink:      #F0F0F0;     /* text on glass (buttons, selected rows)         */
    ink-dim:  #9A9A9A;     /* placeholder on the search pill                 */
    pill:     #1A1A1ACC;   /* dark glass 80% - search pill (hides wallpaper) */
    btn:      #1A1A1ACC;   /* dark glass 80% - mode buttons                  */
    btn-sel:  #5A5A5AED;   /* mid gray 93% - active mode button              */
    urgent:   #C9C9C9;     /* urgent row text, neutral gray                  */
    active:   #FFFFFF21;   /* white 13% - active (focused) row               */

    font: "Iosevka Nerd Font 10";
}

configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";

    display-drun: "Apps";
    display-filebrowser: "Files";
    display-run: "Run";
    display-window: "Windows";
    display-calc: "Calc";
}

window {
    width: 1000px;
    location: center;
    anchor: center;

    padding: 12px;
    border: 1px;
    border-color: @edge;
    border-radius: 20px;
    background-color: @win-bg;
    font: @font;
}

mainbox {
    children: [ header, listview ];
    spacing: 12px;
    padding: 0px;
    border: 1px;
    border-color: transparent;
    border-radius: 0px;
    background-color: transparent;
}

/* wallpaper strip: pill on the left, mode buttons on the right */
header {
    children: [ inputbar, mode-switcher ];
    expand: false;
    orientation: horizontal;
    spacing: 16px;
    padding: 76px 64px;
    border: 1px;
    border-color: transparent;
    border-radius: 18px;
    background-color: @win-fall;
    background-image: url("/home/davi/.cache/rofi-launcher/header.png", none);
}

inputbar {
    orientation: horizontal;
    expand: true;
    children: [ entry ];
    spacing: 8px;
    padding: 0px;
    border: 1px;
    border-color: transparent;
    border-radius: 0px;
    background-color: transparent;
}

prompt {
    content: "";
    text-color: @fg-dim;
    background-color: transparent;
    border: 1px;
    border-color: transparent;
    border-radius: 0px;
    padding: 0px;
}

textbox-prompt-colon {
    text-color: @fg-dim;
    background-color: transparent;
    border: 1px;
    border-color: transparent;
    border-radius: 0px;
    padding: 0px;
}

entry {
    placeholder: "  Search";
    placeholder-color: @ink-dim;
    text-color: @ink;
    background-color: @pill;

    expand: false;
    width: 340px;
    padding: 10px 16px;
    border: 0px;
    border-color: transparent;
    border-radius: 24px;
}

case-indicator {
    text-color: @fg-dim;
    background-color: transparent;
    border: 1px;
    border-color: transparent;
    border-radius: 0px;
    padding: 0px;
}

mode-switcher {
    orientation: horizontal;
    expand: false;
    spacing: 6px;
    padding: 6px 0px;
    border: 1px;
    border-color: transparent;
    border-radius: 0px;
    background-color: transparent;
}

button {
    font: "Iosevka Nerd Font 9";
    expand: false;
    padding: 5px 18px;
    border: 1px;
    border-color: @edge;
    border-radius: 10px;
    background-color: @btn;
    text-color: @ink;
}

button selected {
    background-color: @btn-sel;
    text-color: @ink;
    border-color: @peach;
}

message {
    padding: 8px 12px;
    border: 1px;
    border-color: transparent;
    border-radius: 8px;
    background-color: #1A1A1A94;
    text-color: @fg;
    expand: false;
}

textbox {
    text-color: @fg;
    background-color: transparent;
    border: 1px;
    border-color: transparent;
    border-radius: 6px;
    padding: 0px;
}

listview {
    lines: 8;
    columns: 2;
    fixed-height: true;
    spacing: 6px;
    scrollbar: false;
    padding: 0px;
    border: 1px;
    border-color: transparent;
    border-radius: 0px;
    background-color: transparent;
}

scrollbar {
    width: 6px;
    handle-width: 4px;
    handle-color: #FFFFFF59;
    padding: 0px;
    border: 1px;
    border-color: transparent;
    border-radius: 0px;
    background-color: transparent;
}

element {
    orientation: horizontal;
    spacing: 8px;
    padding: 10px 12px;
    border: 0px;
    border-color: transparent;
    border-radius: 6px;
    background-color: transparent;
    text-color: @fg;
}

element normal normal    { background-color: transparent; text-color: @fg; }
element normal urgent    { background-color: transparent; text-color: @urgent; }
element normal active    { background-color: @active;     text-color: @fg; }
element alternate normal { background-color: transparent; text-color: @fg; }
element alternate urgent { background-color: transparent; text-color: @urgent; }
element alternate active { background-color: @active;     text-color: @fg; }
element selected normal  { background-color: @peach;      text-color: @ink; }
element selected urgent  { background-color: #FFFFFF2E;    text-color: @urgent; }
element selected active  { background-color: #FFFFFF33;     text-color: @ink; }

element-text {
    background-color: inherit;
    text-color: inherit;
    horizontal-align: 0;
}

element-icon {
    background-color: transparent;
    text-color: @fg;
    size: 22px;
}
