/* netmenu.rasi - neutral gray glass popup (polybar network module click). */

* {
    bg:     #2D2D2DC7;   /* rgba(45,45,45,78%) - raised: vivid red wallpaper */
    bg-top: #FFFFFF10;   /* inputbar: white 6% */
    sel:    #FFFFFF1C;   /* selected row: white 11% */
    edge:   #FFFFFF1A;   /* 1px border: white 10% */
    fg:     #E8E8E8;     /* light neutral text */
    fg-dim: #9A9A9A;     /* header, placeholder */

    font: "Iosevka Nerd Font 11";
}

window {
    location: north east;
    width: 340px;
    x-offset: 0px;
    y-offset: 52px;

    padding: 11px;
    background-color: @bg;
    border: 1px;
    border-color: @edge;
    border-radius: 14px;
    font: @font;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 8px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 6px;
    padding: 7px 9px;
    background-color: @bg-top;
    border-radius: 8px;
}

prompt {
    text-color: @fg-dim;
}

entry {
    placeholder: "Filter...";
    placeholder-color: @fg-dim;
    text-color: @fg;
}

message {
    padding: 4px;
    text-color: @fg-dim;
    background-color: transparent;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    spacing: 2px;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 10px 12px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg;
}

element normal normal {
    background-color: transparent;
    text-color: @fg;
}

element selected normal {
    background-color: @sel;
    text-color: @fg;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    horizontal-align: 0;
}
