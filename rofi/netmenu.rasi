/* netmenu.rasi - custom network popup (polybar network module click). */

* {
    bg:        #212B30dd;
    bg-alt:    #3F536044;
    fg:        #C4C7C5;
    accent:    #6C77BB;
    accent-fg: #FFFFFF;
    muted:     #9E9E9E;
    ok:        #61C766;

    font: "Iosevka Nerd Font 11";
}

window {
    location: north east;
    width: 340px;
    x-offset: 0px;
    y-offset: 52px;

    padding: 10px;
    background-color: @bg;
    border: 1px;
    border-color: @accent;
    border-radius: 14px;
    font: @font;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 8px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 6px;
    padding: 6px;
    background-color: @bg-alt;
    border-radius: 8px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Filter...";
    placeholder-color: @muted;
    text-color: @fg;
}

message {
    padding: 4px;
    text-color: @muted;
    background-color: transparent;
}

listview {
    lines: 12;
    columns: 1;
    fixed-height: false;
    spacing: 2px;
    scrollbar: true;
    background-color: transparent;
}

element {
    padding: 6px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg;
}

element normal normal {
    background-color: transparent;
    text-color: @fg;
}

element selected normal {
    background-color: @accent;
    text-color: @accent-fg;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    horizontal-align: 0;
}
